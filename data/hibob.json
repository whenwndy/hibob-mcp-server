  "hr_policies": [
    {
      "id": "POL-001",
      "name": "Benefits Waiting Period Policy",
      "category": "benefits",
      "summary": "New full-time employees are subject to a 30-day waiting period before health benefits (medical, dental, vision) become effective. Coverage begins on the first day of the month following the waiting period. Employees who start on or before the 1st of a month may see benefits effective the following month; employees starting mid-month will see coverage effective the month after next. Devon Harris (start: Sep 2) has benefits effective Oct 1.",
      "effective_date": "2024-01-01",
      "document_url": "https://hr.company.com/policies/benefits-waiting-period"
    },
    {
      "id": "POL-002",
      "name": "Payroll Proration Policy",
      "category": "payroll",
      "summary": "When an employee starts mid-pay-period, their first paycheck is prorated based on actual days worked versus total working days in the pay period. The company uses the 'actual_days' proration method: prorated pay = (full period pay) × (days worked / working days in period). This ensures employees are paid accurately for the exact days they worked in their first partial period.",
      "effective_date": "2023-06-01",
      "document_url": "https://hr.company.com/policies/payroll-proration"
    },
    {
      "id": "POL-003",
      "name": "Time Off Accrual Policy",
      "category": "time_off",
      "summary": "Full-time employees accrue vacation at 1.67 days per month (20 days/year). Sick leave accrues at 0.83 days per month (10 days/year) per California law. New hires receive 3 personal days at hire. PTO begins accruing from the first day of employment. Unused vacation up to 15 days rolls over at year-end; sick and personal days do not roll over.",
      "effective_date": "2024-01-01",
      "document_url": "https://hr.company.com/policies/time-off-accrual"
    },
    {
      "id": "POL-004",
      "name": "90-Day Introductory Period Policy",
      "category": "performance",
      "summary": "All new hires serve a 90-day introductory period beginning on their start date. During this period, managers conduct informal check-ins at 30 and 60 days, with a formal performance review at 90 days. Employees completing the introductory period become eligible for the standard performance review cycle and merit increase consideration. Devon Harris's 90-day period ends December 1, 2026.",
      "effective_date": "2023-01-01",
      "document_url": "https://hr.company.com/policies/introductory-period"
    }
  ]
}
